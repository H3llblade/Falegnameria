{
  "name": "falegnameria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-tesseract.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-tesseract.mjs && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/admin-create.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "postinstall": "prisma generate",
    "e2e": "node tests/e2e/smoke.mjs e2e-screens"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.67.0",
    "next": "15.5.28",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "tesseract.js": false
  },
  "engines": {
    "node": ">=20.9"
  }
}

// Falegnameria — Wild Lands 1900
// Schema relazionale PostgreSQL. Gli importi monetari sono SEMPRE interi in centesimi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum OrderStatus {
  RICEVUTO
  IN_ATTESA
  IN_LAVORAZIONE
  PRONTO
  CONSEGNATO
  ANNULLATO
}

enum AnnouncementCategory {
  AVVISO
  COMUNICAZIONE
  OFFERTA
  RICERCA_MATERIALI
  ANNUNCIO_COMMERCIALE
  ALTRO
}

enum AnnouncementPriority {
  BASSA
  NORMALE
  ALTA
  URGENTE
}

enum AnnouncementStatus {
  BOZZA
  PUBBLICATO
}

enum CategoryKind {
  RECIPE
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  passwordHash String
  role         Role      @default(ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       Session[]
  auditLogs      AuditLog[]
  paymentsMade   Payment[]  @relation("PaymentCreatedBy")
  paymentsVoided Payment[]  @relation("PaymentVoidedBy")
}

model Session {
  // id = hash SHA-256 del token del cookie: il token in chiaro non viene mai salvato
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Contact {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  /// Identificativo Roleplay: sempre stringa (conserva gli zeri iniziali)
  missiveCode String
  activity    String
  city        String?
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders Order[]

  @@index([lastName, firstName])
  @@index([missiveCode])
}

model Category {
  id        String       @id @default(cuid())
  kind      CategoryKind @default(RECIPE)
  name      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  recipes Recipe[]

  @@unique([kind, name])
}

model Recipe {
  id                   String    @id @default(cuid())
  name                 String
  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description          String    @default("")
  tools                String    @default("")
  procedure            String    @default("")
  timeMinutes          Int?
  /// Unità prodotte con una esecuzione della ricetta (i materiali si riferiscono a questa resa)
  yieldQuantity        Int       @default(1)
  materialCostCents    Int?
  suggestedPriceCents  Int?
  notes                String?
  imageData            Bytes?
  imageMime            String?
  /// Le ricette dimostrative create dal seed sono marcate esplicitamente
  isDemo               Boolean   @default(false)
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  materials  RecipeMaterial[]
  orderItems OrderItem[]

  @@index([name])
  @@index([categoryId])
}

model RecipeMaterial {
  id        String  @id @default(cuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal @db.Decimal(12, 3)
  unit      String  @default("")
  sortOrder Int     @default(0)

  @@index([recipeId])
}

model Order {
  id     String @id @default(cuid())
  /// Numero progressivo automatico (sequenza PostgreSQL)
  number Int    @unique @default(autoincrement())

  contactId       String?
  contact         Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Dati del cliente "fotografati" alla creazione: restano anche se il contatto viene eliminato
  customerName    String
  customerMissive String      @default("")
  title           String
  description     String      @default("")
  dueDate         DateTime?
  notes           String?
  status          OrderStatus @default(RICEVUTO)

  /// Valori derivati, ricalcolati in transazione da righe e pagamenti
  totalCents Int @default(0)
  paidCents  Int @default(0)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([status])
  @@index([createdAt])
  @@index([contactId])
  @@index([archivedAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipeId       String?
  recipe         Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  description    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  /// Copia della ricetta al momento dell'ordine: { yield, materials } (materiali per una esecuzione).
  /// Gli ordini precedenti alla resa contengono il solo array dei materiali (resa 1).
  materialsSnapshot Json?
  sortOrder      Int     @default(0)

  @@index([orderId])
  @@index([recipeId])
}

model Payment {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountCents Int
  method      String?
  note        String?
  paidAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  createdBy   User?     @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Annullamento: il pagamento resta nello storico ma non conta negli incassi
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?     @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason  String?

  @@index([orderId])
  @@index([paidAt])
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  content     String
  category    AnnouncementCategory @default(AVVISO)
  priority    AnnouncementPriority @default(NORMALE)
  pinned      Boolean              @default(false)
  status      AnnouncementStatus   @default(BOZZA)
  publishedAt DateTime             @default(now())
  expiresAt   DateTime?
  archivedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, publishedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Impostazioni dell'applicazione modificabili dall'amministratore (es. sezioni pubbliche)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

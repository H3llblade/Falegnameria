# ---------------------------------------------------------------------------
# Falegnameria — variabili d'ambiente. Copiare in .env (mai versionato).
# ---------------------------------------------------------------------------

# PostgreSQL (in produzione: database e utente dedicati, creati da scripts/vps/setup.sh)
DATABASE_URL="postgresql://falegnameria:falegnameria_dev@localhost:5432/falegnameria?schema=public"

# URL pubblico (usato per la protezione CSRF delle azioni server)
APP_URL="http://localhost:3000"

# Porta locale di Next.js in produzione (scegliere una porta libera sulla VPS)
PORT=3100
# Nome del processo PM2 (deve essere unico sulla VPS)
PM2_NAME=falegnameria

# Durata della sessione di accesso (giorni)
SESSION_DAYS=7
# Tentativi di login falliti prima del blocco temporaneo (15 minuti)
LOGIN_MAX_ATTEMPTS=5
# Solo per provare la build di produzione senza HTTPS in locale: false
# COOKIE_SECURE=false

# Fuso orario per date e filtri degli incassi
NEXT_PUBLIC_TIMEZONE=Europe/Rome

# Backup (fuori dalla directory del repository)
BACKUP_DIR=/var/backups/falegnameria
BACKUP_RETENTION_DAYS=30

# OCR: percorso alternativo dei dizionari Tesseract (default: CDN jsDelivr, gratuito)
# NEXT_PUBLIC_OCR_LANG_PATH=/tesseract/lang

# Database di test per gli scenari d'integrazione (viene SVUOTATO dai test)
# TEST_DATABASE_URL="postgresql://falegnameria:falegnameria_dev@localhost:5432/falegnameria_test?schema=public"
